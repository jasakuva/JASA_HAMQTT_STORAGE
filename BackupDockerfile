FROM docker.io/pgedge/pgbackrest:2.58 AS pgbackrest

FROM docker.io/library/python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bzip2 \
        ca-certificates \
        libbz2-1.0 \
        liblz4-1 \
        libpq5 \
        libssl3 \
        libssh2-1 \
        libxml2 \
        libyaml-0-2 \
        libzstd1 \
        gnupg \
        wget \
    && rm -rf /var/lib/apt/lists/*

RUN install -d /usr/share/postgresql-common/pgdg \
    && wget -qO /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install --no-install-recommends -y postgresql-client-17 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pgbackrest /build/pgbackrest/build/src/pgbackrest-amd64 /usr/local/bin/pgbackrest

COPY pyproject.toml requirements.txt ./
COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

RUN chmod 0755 /usr/local/bin/pgbackrest \
    && command -v pgbackrest \
    && test "$(pgbackrest version)" = "pgBackRest 2.58.0" \
    && test "$(pg_dump --version | awk '{print $3}' | cut -d. -f1)" = "17"

CMD ["python", "-m", "hamqtt_store.cli", "backup"]