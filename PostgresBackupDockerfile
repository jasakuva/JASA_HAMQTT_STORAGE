FROM docker.io/pgedge/pgbackrest:2.58 AS pgbackrest
FROM pgvector/pgvector:0.8.7-pg17-bookworm

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bzip2 \
        libbz2-1.0 \
        liblz4-1 \
        libpq5 \
        libssl3 \
        libssh2-1 \
        libxml2 \
        libyaml-0-2 \
        libzstd1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pgbackrest /build/pgbackrest/build/src/pgbackrest-amd64 /usr/local/bin/pgbackrest

RUN chmod 0755 /usr/local/bin/pgbackrest \
    && test "$(pgbackrest version)" = "pgBackRest 2.58.0"