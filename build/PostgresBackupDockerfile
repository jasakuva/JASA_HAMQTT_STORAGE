FROM docker.io/pgedge/pgbackrest:2.58 AS pgbackrest
FROM pgvector/pgvector:0.8.7-pg17-bookworm

ARG IMAGE_VERSION=dev
ARG IMAGE_REVISION=unknown

LABEL org.opencontainers.image.title="HAMQTT PostgreSQL with pgBackRest" \
      org.opencontainers.image.description="PostgreSQL 17 with pgvector and pgBackRest for HAMQTT Store" \
      org.opencontainers.image.source="https://github.com/jasakuva/JASA_HAMQTT_STORAGE" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}"

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
        bzip2 \
        libbz2-1.0 \
        liblz4-1 \
        libpq5 \
        libssl3 \
        libssh2-1 \
        libxml2 \
        libyaml-0-2 \
        libzstd1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=pgbackrest /build/pgbackrest/build/src/pgbackrest-amd64 /usr/local/bin/pgbackrest

RUN chmod 0755 /usr/local/bin/pgbackrest \
    && test "$(pgbackrest version)" = "pgBackRest 2.58.0"