# Local development database settings
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg17-bookworm
POSTGRES_CONTAINER_NAME=hamqtt-postgres
POSTGRES_DB=hamqtt_store
POSTGRES_USER=hamqtt
POSTGRES_PASSWORD=change-this-development-password
# 0.0.0.0 exposes PostgreSQL on the host and internal network interfaces.
# Use 127.0.0.1 to allow only local host access.
POSTGRES_BIND_IP=0.0.0.0
POSTGRES_PORT=5432
POSTGRES_VOLUME=hamqtt-postgres-data
POSTGRES_NETWORK=hamqtt-store-network
# Persistent web application data, including the authentication reset marker.
APP_DATA_VOLUME=hamqtt-app-data
# Host directory mounted into the dedicated PostgreSQL backup service.
BACKUP_HOST_PATH=./backups
# Maximum browser recovery upload size in megabytes.
RECOVERY_MAX_UPLOAD_MB=1024
# Long-lived browser session duration.
SESSION_DAYS=365
# Set true when the web UI is served through HTTPS.
SESSION_COOKIE_SECURE=false
# Shared short-lived dashboard cache.
REDIS_URL=redis://localhost:6379/0
